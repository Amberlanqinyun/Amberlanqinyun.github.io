          "en": "Check the assistants",
          "zh": "检查 AI 助手"
        },
        "note": {
          "en": "your baseline list",
          "zh": "建立基准清单"
        }
      },
      {
        "id": "s2",
        "col": 1,
        "row": 0,
        "label": {
          "en": "Let the crawlers in",
          "zh": "放行爬虫"
        },
        "note": {
          "en": "robots.txt and Bing",
          "zh": "robots.txt 和 Bing"
        }
      },
      {
        "id": "s3",
